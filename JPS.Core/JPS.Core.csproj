<Project Sdk="Microsoft.NET.Sdk">

  <!--
    核心算法库（UI 无关、可移植到 Unity 2022）。
    刻意锁定 netstandard2.1 + C# 9，与 Unity 2022 的运行时/语言版本对齐——
    这样任何 net-only API 或 C#10+ 语法会在此被编译期拦截，保证源码可直接拷入 Unity。
    （故不启用 ImplicitUsings：global using 需 C# 10，且 Unity 端需各文件自带 using。）
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>JPS</RootNamespace>
    <AssemblyName>JPS.Core</AssemblyName>
    <!--
      默认开启多线程支持：跳点缓存的惰性补写用 Volatile 做 acquire/release 发布，
      多个 JpsPathfinder 可共享同一 JpsSystem 并行寻路。x86/x64 上额外开销可忽略。
      如需榨干单线程极速（尤其 ARM），把下面这行去掉即可退回普通读写。
    -->
    <DefineConstants>$(DefineConstants);JPS_CONCURRENT_CACHE</DefineConstants>
  </PropertyGroup>

  <!-- 基准/压测项目需要访问内部的 JpsDirections 代价常量。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="JPS.Benchmark" />
  </ItemGroup>

</Project>
