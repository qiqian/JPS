<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms 演示界面（桌面专用），引用核心算法库。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JPS</RootNamespace>
    <AssemblyName>JPS.Playground</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <ProjectReference Include="..\JPS.Core\JPS.Core.csproj" />
    <ProjectReference Include="..\JPS.Data\JPS.Data.csproj" />
    <ProjectReference Include="..\JPS.Native.CSharp\JPS.Native.CSharp.csproj" />
    <ProjectReference Include="..\JPS.Native\JPS.Native.vcxproj"
                      Condition="'$(JpsSkipNativeBuild)' != 'true'" />
  </ItemGroup>

</Project>
